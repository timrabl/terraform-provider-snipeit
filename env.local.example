# Copy to env.local and fill in. env.local is gitignored and loaded
# automatically by mise for every task (dev:up, testacc, ...).

# --- dev instance (dev/docker-compose.yml) ---

# Required. Laravel app key for the dev instance:
#   echo "SNIPEIT_DEV_APP_KEY=base64:$(openssl rand -base64 32)" >> env.local
SNIPEIT_DEV_APP_KEY=

# Where the dev instance is reachable FROM YOUR MACHINE. Defaults assume a
# local docker daemon. Point these at your remote docker host if you use one.
#SNIPEIT_DEV_APP_URL=http://localhost:8085
#SNIPEIT_DEV_COOKIE_DOMAIN=localhost
#SNIPEIT_DEV_HTTP_PORT=8085

# Database passwords for the throwaway instance. Fine to leave defaulted,
# but note: MariaDB bakes them into the volume on first start, so set them
# BEFORE the first `mise run dev:up` or wipe with `mise run dev:destroy`.
#SNIPEIT_DEV_DB_PASSWORD=
#SNIPEIT_DEV_DB_ROOT_PASSWORD=

# Snipe-IT image tag, pinned by default to match what we test against.
#SNIPEIT_DEV_VERSION=v8.0.4

# --- acceptance tests (mise run testacc) ---

# API token: log into the dev instance, top-right user menu -> Manage API
# Keys -> create token, paste here.
SNIPE_IT_API_TOKEN=

# Defaults to SNIPEIT_DEV_APP_URL (or http://localhost:8085) if unset.
#SNIPEIT_URL=
